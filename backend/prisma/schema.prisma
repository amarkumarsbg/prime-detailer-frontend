generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  MANAGER
  SUPERVISOR
  RECEPTIONIST
  MECHANIC
}

enum VehicleSegment {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  MUV
  COMPACT_SUV
  BIKE
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Branch {
  id           String   @id
  name         String
  address      String
  phone        String
  isActive     Boolean  @default(true)
  qrCodeId     String?
  code         String?
  city         String?
  state        String?
  pincode      String?
  email        String?
  managerName  String?
  managerPhone String?
  users        User[]
  attendanceRecords Attendance[]
}

model User {
  id                   String   @id
  name                 String
  email                String   @unique
  phone                String
  employeeCode         String?  @unique
  role                 UserRole
  branchId             String
  branch               Branch   @relation(fields: [branchId], references: [id])
  avatar               String?
  isActive             Boolean  @default(true)
  emailVerified        Boolean  @default(false)
  attendancePin        String?
  totalJobsCompleted   Int?
  totalIncentiveEarned Int?
  birthday             String?
  anniversary          String?
  passwordHash         String
  /** When true, client should force a password change before using the app (set for auto-generated onboarding passwords). */
  mustChangePassword   Boolean  @default(false)
  /** Staff user id (`User.id`) of the admin who last set the initial/onboarding password, when tracked. */
  passwordCreatedBy    String?
  /** Last time the login password hash was replaced (create, reset, or authenticated change). */
  passwordUpdatedAt    DateTime?
  /** SHA-256 hex of opaque reset token; cleared after reset or superseded by new request */
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  attendanceRecords      Attendance[]
}

model Customer {
  id            String    @id
  name          String
  phone         String
  email         String
  address       String
  referralCode  String
  referredBy    String?
  totalVisits   Int       @default(0)
  rewardPoints  Int       @default(0)
  walletBalance Float     @default(0)
  lastVisitDate String?
  isInactive    Boolean   @default(false)
  emailVerified Boolean   @default(false)
  createdAt     DateTime
  vehicles      Vehicle[]
}

model Vehicle {
  id                 String         @id
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName       String
  registrationNumber String
  make               String
  model              String
  segment            VehicleSegment
  variant            String?
  fuelType           FuelType
  color              String
  year               Int
  notes              String?
  previousOwners     Json?
}

/** Staff attendance punches (check-in / check-out). One row per shift. `date`/`checkIn`/`checkOut` are the staff member's LOCAL calendar values (yyyy-MM-dd / HH:mm) so server timezone never shifts them. */
model Attendance {
  id              String           @id @default(cuid())
  staffId         String
  staff           User             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffName       String
  staffRole       UserRole
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  date            String
  checkIn         String?
  checkOut        String?
  durationMinutes Int?
  status          AttendanceStatus
  qrScanned       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([branchId, date])
  @@index([staffId, branchId, date])
}

/** JSON documents keyed by collection name + entity id (e.g. jobCards / jc-001). */
model AppJsonRow {
  collection String
  entityId   String
  payload    Json
  updatedAt  DateTime @updatedAt

  @@id([collection, entityId])
}
